{
  "expo": {
    "name": "Super App",
    "slug": "super-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.harshith.superapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "JAUSPN67UY"
    },
    "android": {
      "package": "com.harshith.superapp"
    },
    "extra": {
      "apiUrl": "https://app.nutrishiksha.com"
    },
    "scheme": "superapp",
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nano listens while you answer its interview questions.",
          "speechRecognitionPermission": "Your spoken answers are transcribed on this device."
        }
      ]
    ]
  }
}
