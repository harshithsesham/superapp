# Copy to .env and fill in. Everything is prefixed SUPERAPP_.
SUPERAPP_DATABASE_URL=postgresql+psycopg2://superapp:superapp@localhost:5432/superapp
SUPERAPP_API_TOKEN=change-me-to-a-long-random-string
# Leave empty to run the LLM provider in offline stub mode:
SUPERAPP_ANTHROPIC_API_KEY=

# Plaid (Phase 2). Leave client_id empty for deterministic stub-bank mode.
SUPERAPP_PLAID_CLIENT_ID=
SUPERAPP_PLAID_SECRET=
SUPERAPP_PLAID_ENV=sandbox
SUPERAPP_PLAID_WEBHOOK_TOKEN=change-me-webhook-token

# Token vault key (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = derived from api_token (dev only).
SUPERAPP_VAULT_KEY=

# Gmail / Nano inbox (Phase 3). Leave client_id empty for the stub mailbox.
# console.cloud.google.com -> OAuth client (Web), redirect http://localhost:8000/v1/gmail/callback
SUPERAPP_GOOGLE_CLIENT_ID=
SUPERAPP_GOOGLE_CLIENT_SECRET=
# Trust ladder: read -> send -> modify
SUPERAPP_GMAIL_SCOPE_TIER=read
SUPERAPP_GMAIL_WEBHOOK_TOKEN=change-me-gmail-webhook
# Pub/Sub topic for instant push ingestion (optional; polling works without):
SUPERAPP_GMAIL_PUBSUB_TOPIC=
