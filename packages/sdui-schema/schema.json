{
  "$defs": {
    "Action": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "style": {
          "default": "primary",
          "enum": [
            "primary",
            "secondary",
            "destructive"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionRow": {
      "properties": {
        "type": {
          "const": "action_row",
          "default": "action_row",
          "title": "Type",
          "type": "string"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "actions"
      ],
      "title": "ActionRow",
      "type": "object"
    },
    "AgentCard": {
      "description": "The hero card (Nano V1 \"My Hub\"): one agent, its live status, a serif\nheadline, and inline stat cells.",
      "properties": {
        "type": {
          "const": "agent_card",
          "default": "agent_card",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sub": {
          "title": "Sub",
          "type": "string"
        },
        "live": {
          "default": false,
          "title": "Live",
          "type": "boolean"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "stats": {
          "items": {
            "$ref": "#/$defs/AgentStat"
          },
          "title": "Stats",
          "type": "array"
        },
        "screen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen"
        }
      },
      "required": [
        "id",
        "agent",
        "name",
        "sub",
        "headline",
        "body"
      ],
      "title": "AgentCard",
      "type": "object"
    },
    "AgentGrid": {
      "description": "The hub's agent roster (Nano V1 \"Coming to your Hub\", except ours are live).",
      "properties": {
        "type": {
          "const": "agent_grid",
          "default": "agent_grid",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/AgentGridItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AgentGrid",
      "type": "object"
    },
    "AgentGridItem": {
      "properties": {
        "screen": {
          "title": "Screen",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sub": {
          "title": "Sub",
          "type": "string"
        },
        "tone": {
          "default": "indigo",
          "enum": [
            "indigo",
            "mint",
            "amber",
            "rose"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "screen",
        "name",
        "sub"
      ],
      "title": "AgentGridItem",
      "type": "object"
    },
    "AgentStat": {
      "properties": {
        "n": {
          "title": "N",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "accent": {
          "default": false,
          "title": "Accent",
          "type": "boolean"
        }
      },
      "required": [
        "n",
        "label"
      ],
      "title": "AgentStat",
      "type": "object"
    },
    "DraftCard": {
      "description": "A reply written and waiting (the Nano inbox). The client owns the feel:\ninline editing, optimistic send, defer. id is the draft id; the client\ncalls the draft endpoints and logs reactions.",
      "properties": {
        "type": {
          "const": "draft_card",
          "default": "draft_card",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "from_name": {
          "title": "From Name",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "draft": {
          "title": "Draft",
          "type": "string"
        },
        "status": {
          "default": "waiting",
          "enum": [
            "waiting",
            "edited",
            "sent",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "deferred_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deferred Label"
        },
        "why_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why Detail"
        }
      },
      "required": [
        "id",
        "agent",
        "from_name",
        "subject",
        "why",
        "draft"
      ],
      "title": "DraftCard",
      "type": "object"
    },
    "GridImage": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image_url": {
          "title": "Image Url",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "image_url"
      ],
      "title": "GridImage",
      "type": "object"
    },
    "ImageCard": {
      "properties": {
        "type": {
          "const": "image_card",
          "default": "image_card",
          "title": "Type",
          "type": "string"
        },
        "image_url": {
          "title": "Image Url",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        }
      },
      "required": [
        "image_url"
      ],
      "title": "ImageCard",
      "type": "object"
    },
    "ImageGrid": {
      "description": "Thumbnail grid (the closet). Taps log a reaction with the item id.",
      "properties": {
        "type": {
          "const": "image_grid",
          "default": "image_grid",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/GridImage"
          },
          "title": "Items",
          "type": "array"
        },
        "columns": {
          "default": 3,
          "enum": [
            2,
            3,
            4
          ],
          "title": "Columns",
          "type": "integer"
        }
      },
      "required": [
        "items"
      ],
      "title": "ImageGrid",
      "type": "object"
    },
    "InsightCard": {
      "description": "The workhorse: one insight from one agent, dismissible, optionally actionable.",
      "properties": {
        "type": {
          "const": "insight_card",
          "default": "insight_card",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "emphasis": {
          "default": "default",
          "enum": [
            "default",
            "positive",
            "warning"
          ],
          "title": "Emphasis",
          "type": "string"
        },
        "action_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Label"
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        }
      },
      "required": [
        "id",
        "agent",
        "title",
        "body"
      ],
      "title": "InsightCard",
      "type": "object"
    },
    "ListBlock": {
      "properties": {
        "type": {
          "const": "list",
          "default": "list",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ListItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ListBlock",
      "type": "object"
    },
    "ListItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "trailing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trailing"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
