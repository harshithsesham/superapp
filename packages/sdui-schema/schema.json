    "Meter": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "unit": {
          "default": "g",
          "title": "Unit",
          "type": "string"
        },
        "tone": {
          "default": "lavender",
          "enum": [
            "mint",
            "lavender",
            "rose",
            "amber"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value",
        "max"
      ],
      "title": "Meter",
      "type": "object"
    },
    "MeterRow": {
      "description": "Thin progress lines \u2014 Nano's answer to macro rings.",
      "properties": {
        "type": {
          "const": "meter_row",
          "default": "meter_row",
          "title": "Type",
          "type": "string"
        },
        "meters": {
          "items": {
            "$ref": "#/$defs/Meter"
