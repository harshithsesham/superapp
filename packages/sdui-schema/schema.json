      "type": "object"
    },
    "TimelineItem": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "verdict": {
          "title": "Verdict",
          "type": "string"
        },
        "tone": {
          "default": "filed",
          "enum": [
            "ask",
            "did",
            "filed"
          ],
          "title": "Tone",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "text",
        "verdict",
        "at"
      ],
      "title": "TimelineItem",
      "type": "object"
    }
  },
  "description": "Top-level payload for any screen the client renders.",
  "properties": {
    "type": {
      "const": "screen",
      "default": "screen",
      "title": "Type",
      "type": "string"
    },
    "theme": {
      "default": "light",
      "enum": [
        "light",
        "dark"
      ],
      "title": "Theme",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "title",
    "sections"
  ],
  "title": "Screen",
  "type": "object"
}
