          "title": "Meters",
          "type": "array"
        }
      },
      "required": [
        "meters"
      ],
      "title": "MeterRow",
      "type": "object"
    },
    "OutfitCard": {
      "description": "One suggested outfit: garment strip + rationale + like/dislike.\nThe client posts outfit_liked / outfit_rejected reactions with this id.",
      "properties": {
        "type": {
          "const": "outfit_card",
          "default": "outfit_card",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "occasion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occasion"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/OutfitItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "agent",
        "title",
        "rationale",
        "items"
      ],
      "title": "OutfitCard",
      "type": "object"
    },
    "OutfitItem": {
      "properties": {
        "garment_id": {
          "title": "Garment Id",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "garment_id",
        "label"
      ],
      "title": "OutfitItem",
      "type": "object"
    },
    "Section": {
      "properties": {
        "type": {
          "const": "section",
          "default": "section",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "action_row": "#/$defs/ActionRow",
                "agent_card": "#/$defs/AgentCard",
                "agent_grid": "#/$defs/AgentGrid",
                "draft_card": "#/$defs/DraftCard",
                "image_card": "#/$defs/ImageCard",
                "image_grid": "#/$defs/ImageGrid",
                "insight_card": "#/$defs/InsightCard",
                "list": "#/$defs/ListBlock",
                "meter_row": "#/$defs/MeterRow",
                "outfit_card": "#/$defs/OutfitCard",
                "stat_row": "#/$defs/StatRow",
                "text": "#/$defs/TextBlock",
                "timeline": "#/$defs/Timeline"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextBlock"
              },
              {
                "$ref": "#/$defs/InsightCard"
              },
              {
                "$ref": "#/$defs/StatRow"
              },
              {
                "$ref": "#/$defs/ImageCard"
              },
              {
                "$ref": "#/$defs/ListBlock"
              },
              {
                "$ref": "#/$defs/ImageGrid"
              },
              {
                "$ref": "#/$defs/OutfitCard"
              },
              {
                "$ref": "#/$defs/AgentCard"
              },
              {
                "$ref": "#/$defs/AgentGrid"
              },
              {
                "$ref": "#/$defs/DraftCard"
              },
              {
                "$ref": "#/$defs/Timeline"
              },
              {
                "$ref": "#/$defs/MeterRow"
              },
              {
                "$ref": "#/$defs/ActionRow"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "blocks"
      ],
      "title": "Section",
      "type": "object"
    },
    "Stat": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Stat",
      "type": "object"
    },
    "StatRow": {
      "properties": {
        "type": {
          "const": "stat_row",
          "default": "stat_row",
          "title": "Type",
          "type": "string"
        },
        "stats": {
          "items": {
            "$ref": "#/$defs/Stat"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Stats",
          "type": "array"
        }
      },
      "required": [
        "stats"
      ],
      "title": "StatRow",
      "type": "object"
    },
    "TextBlock": {
      "properties": {
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "default": "body",
          "enum": [
            "body",
            "title",
            "subtitle",
            "caption"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "Timeline": {
      "description": "The signal-fate ledger (Nano V4): every signal ends in a verdict.",
      "properties": {
        "type": {
          "const": "timeline",
          "default": "timeline",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/TimelineItem"
          },
          "title": "Items",
          "type": "array"
        },
        "footer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer"
